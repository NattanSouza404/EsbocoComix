{
  "compilerOptions": {
    "allowJs": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "checkJs": true,
    "moduleResolution": "node16",
    "target": "es2020",
    "module": "node16",
    "paths": {
      "@api/*": ["./api/*"],
      "@paginas/*": ["./paginas/*"],
      "@componentes/*": ["./componentes/*"],
      "@dominio/*": ["./dominio/*"],
      "@storage/*": ["./storage/*"],
      "@utils/*": ["./utils/*"]
    },
    "lib": ["DOM", "ES2020"]
  },
  "include": [
    "js/**/*.js",
    "paginas/**/*.js"
, "deps/chart.umd.js", "script.js"  ],
  "exclude": [
    "**/bootstrap.bundle.min.js",
    "**/chart.umd.js"
  ]
}
