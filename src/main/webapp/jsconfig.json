{
  "compilerOptions": {
    "allowJs": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "checkJs": true,
    "module": "es2020",
    "moduleResolution": "bundler",
    "target": "es2020",
    "paths": {
      "@api/*": ["./api/*"],
      "@paginas/*": ["./paginas/*"],
      "@componentes/*": ["./componentes/*"],
      "@dominio/*": ["./dominio/*"],
      "@storage/*": ["./storage/*"],
      "@utils/*": ["./utils/*"]
    },
    "lib": ["DOM", "ES2020"]
  },
  "include": [
    "**/*.js"
  ],
  "exclude": [
    "**/bootstrap.bundle.min.js",
    "**/chart.umd.js"
  ]
}
