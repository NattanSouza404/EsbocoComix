{
  "compilerOptions": {
    "allowJs": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "checkJs": true,
    "moduleResolution": "node16",
    "target": "es2020",
    "module": "node16",
    "paths": {
      "@api/*": ["./js/api/*"],
      "@paginas/*": ["./paginas/*"],
      "@componentes/*": ["./js/componentes/*"],
      "@dominio/*": ["./js/dominio/*"],
      "@storage/*": ["./js/storage/*"],
      "@utils/*": ["./js/utils/*"]
    },
    "lib": ["DOM", "ES2020"]
  },
  "include": [
    "js/**/*.js",
    "paginas/**/*.js"
  ],
  "exclude": [
    "**/bootstrap.bundle.min.js",
    "**/chart.umd.js"
  ]
}
